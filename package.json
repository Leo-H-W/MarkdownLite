{
  "name": "markdownlite",
  "version": "1.0.0",
  "description": "Lightweight no-install local Markdown editor and viewer with GitHub-style rendering",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:win": "pkg . --output dist/markdownlite.exe && node scripts/set-windows-gui.js"
  },
  "pkg": {
    "targets": [
      "node18-win-x64"
    ],
    "assets": [
      "public/**/*"
    ]
  },
  "dependencies": {
    "express": "^4.18.2",
    "marked": "^12.0.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
